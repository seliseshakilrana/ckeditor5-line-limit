{
  "name": "@shakil.rana.selisegroup/ckeditor5-line-limit",
  "version": "0.0.1",
  "description": "A CKEditor 5 plugin that hard-wraps lines at a fixed number of characters, enforces a strict line limit and counts words, characters and lines.",
  "keywords": [
    "ckeditor",
    "ckeditor5",
    "ckeditor 5",
    "ckeditor5-feature",
    "ckeditor5-plugin",
    "line-limit",
    "word-wrap",
    "word-count",
    "line-count"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": "./dist/*",
    "./browser/*": null,
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=5.7.1"
  },
  "files": [
    "dist",
    "ckeditor5-metadata.json"
  ],
  "devDependencies": {
    "@ckeditor/ckeditor5-dev-build-tools": "63.0.0",
    "@ckeditor/ckeditor5-inspector": ">=5.0.4",
    "@ckeditor/ckeditor5-package-tools": "^5.1.0",
    "@typescript-eslint/eslint-plugin": "~5.43.0",
    "@typescript-eslint/parser": "^5.18.0",
    "@vitest/coverage-istanbul": "^2.0.5",
    "@vitest/browser": "^2.0.5",
    "ckeditor5": "^49.0.0",
    "eslint": "^7.32.0",
    "eslint-config-ckeditor5": "^9.0.0",
    "http-server": "^14.1.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.6",
    "stylelint": "^13.13.1",
    "stylelint-config-ckeditor5": "^5.3.2",
    "ts-node": "^10.9.1",
    "typescript": "5.0.4",
    "vite-plugin-svgo": "~1.4.0",
    "vitest": "^2.0.5",
    "webdriverio": "^9.0.7",
    "vite": "^5.4.21"
  },
  "peerDependencies": {
    "ckeditor5": ">=46.0.0 || ^0.0.0-nightly"
  },
  "scripts": {
    "build:dist": "node ./scripts/build-dist.mjs",
    "lint": "eslint \"**/*.{js,ts}\" --quiet",
    "start": "vite sample --open",
    "stylelint": "stylelint --quiet --allow-empty-input 'theme/**/*.css'",
    "test": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --browser.headless=false",
    "prepare": "npm run build:dist",
    "prepublishOnly": "npm run lint && vitest run && npm run build:dist",
    "translations:synchronize": "ckeditor5-package-tools translations:synchronize",
    "translations:validate": "ckeditor5-package-tools translations:synchronize --validate-only"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --quiet"
    ],
    "**/*.css": [
      "stylelint --quiet --allow-empty-input"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "author": "Md Shakil Rana",
  "publishConfig": {
    "access": "public"
  }
}
